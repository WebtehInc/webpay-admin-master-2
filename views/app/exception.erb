<strong>Exception:</strong>
<pre>
<%= "#{e.class}: #{e.message}" %>
</pre>

<strong>Backtrace</strong>
<pre>
<%= "#{e.backtrace.join("\n")}" %>
</pre>

<strong>Path:</strong>
<pre>
<%= "#{context.request.path}" %>
</pre>

<strong>Params</strong>
<pre>
<%= "#{Utils.format_hash[Utils.shallow_hash_filter(context.request.params)]}" %>
</pre>


<strong>ENV:</strong>
<pre>
<%= "#{Utils.format_hash[Utils.shallow_hash_filter(context.env, 'roda.json_params')]}" %>
</pre>