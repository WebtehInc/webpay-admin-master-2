<html>
  <head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/1.11.8/semantic.min.css"/>
  </head>

  <body>
    <div class="ui container" style="margin: 1em;">

      <h2 class="ui header">
        <div class="content">
          Document status update
          <div class="sub header">
            <%= WebPayAdmin.opts[:bank_name] %> <%= WebPayAdmin.opts[:app_name] %>
          </div>
        </div>
      </h2>

      <p>
        Dear <%= "#{user[:first_name]} #{user[:last_name]}" %>, we reviewed your uploaded document:
      </p>

      <ul>
        <li>Document type: <strong><%= DOCUMENT_TYPES[document.type.to_sym] %></strong></li>
        <li>Document upload date: <strong><%= document.created_at %></strong></li>
        <li>Document status: <strong><%= document.status.capitalize %></strong></li>
        <li>Notice: <strong><%= document.comment %></strong></li>
      </ul>

      <p>Have a nice day!</p>

    </div>
  </body>

</html>