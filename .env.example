# WebPay Admin Master Environment Configuration
# Copy this file to .env and adjust values for your environment

# ======================================
# ENVIRONMENT
# ======================================
WP_ENV=development
RACK_ENV=development

# ======================================
# DATABASE (Aurora PostgreSQL 16.9)
# ======================================
# Format: postgres://user:password@host:port/database
WP_DEV_DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@uat-aurora-pg16.cluster-ck3ueww0umem.us-east-1.rds.amazonaws.com:5432/webpay_development

# ======================================
# SMTP (Email Configuration)
# ======================================
# UAT uses sendmail (local)
WP_SMTP_HOST=localhost
WP_SMTP_PORT=25

# ======================================
# REDIS (AWS ElastiCache)
# ======================================
REDIS_URL=redis://uat-webpay-redis.ray4je.ng.0001.use1.cache.amazonaws.com:6379/0

# ======================================
# MEMCACHED (AWS ElastiCache)
# ======================================
MEMCACHED_URL=uat-webpay-memcached.ray4je.0001.use1.cache.amazonaws.com:11211
MEMCACHED_PORT=11211

# ======================================
# SERVER CONFIGURATION
# ======================================
PORT=5555
PUMA_MAX_PROCESSES=2
PUMA_MAX_THREADS=5

# ======================================
# SECURITY
# ======================================
# Session Secret - Generate with: openssl rand -hex 64
SESSION_SECRET=YOUR_SESSION_SECRET_HERE

# JWT Configuration - Generate with: openssl rand -base64 32
JWT_KEY=YOUR_JWT_KEY_HERE
JWT_TTL=7200

# ======================================
# APPLICATION SETTINGS
# ======================================
APP_NAME=WebPay Admin UAT
BANK_NAME=VidaNova Bank

# Error notifications
ERROR_EMAIL=tech@vidanovabank.services

# ======================================
# CORS & SPA
# ======================================
CORS_ALLOWED_ORIGINS=https://webpay-admin-spa.uat.vidanovabank.services
WP_SPA_HOST_URL=https://webpay-admin-spa.uat.vidanovabank.services

# ======================================
# CARD ISSUING (UAT Test Configuration)
# ======================================
# Comma-separated list of test BINs
LOCAL_CARD_BINS=123456,654321

# NFC Writer API Configuration
NFC_WRITER_ACCESS_TOKENS=token1,token2
NFC_WRITER_API_KEY=YOUR_API_KEY_HERE

# ======================================
# LOGGING
# ======================================
LOG_LEVEL=info
