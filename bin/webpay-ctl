#!/usr/bin/env bash
#
# WebPay Control Script
# Manages all WebPay services (start/stop/restart/graceful/status)
#
# Usage:
#   webpay-ctl start [service]         - Start all services or specific service
#   webpay-ctl stop [service]          - Stop all services or specific service
#   webpay-ctl restart [service]       - Restart all services or specific service
#   webpay-ctl graceful [service]      - Graceful restart (zero-downtime for Puma)
#   webpay-ctl status [service]        - Show status of all services or specific service
#   webpay-ctl logs [service]          - Tail logs for service
#
# Services: master, admin-master, spa, admin-spa, all
#

set -e

# Initialize rbenv if available (for Ruby version management)
if command -v rbenv >/dev/null 2>&1; then
    eval "$(rbenv init - bash)"
fi

# Determine the base directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Service definitions
declare -A SERVICES=(
    ["master"]="webpay-master/v2-current"
    ["admin-master"]="webpay-admin-master/v2-current"
    ["spa"]="webpay-spa/v2-current"
    ["admin-spa"]="webpay-admin-spa/v2-current"
)

declare -A SERVICE_TYPES=(
    ["master"]="puma"
    ["admin-master"]="puma"
    ["spa"]="webpack"
    ["admin-spa"]="webpack"
)

declare -A SERVICE_PORTS=(
    ["master"]="4444"
    ["admin-master"]="5555"
    ["spa"]="2222"
    ["admin-spa"]="3333"
)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Log functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Detect OS
detect_os() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    elif [[ -f /etc/os-release ]]; then
        . /etc/os-release
        if [[ "$ID" == "amzn" ]]; then
            echo "amazon-linux"
        else
            echo "linux"
        fi
    else
        echo "unknown"
    fi
}

OS_TYPE=$(detect_os)

# Get PID file path
get_pidfile() {
    local service=$1
    echo "$BASE_DIR/tmp/pids/${service}.pid"
}

# Get log file path
get_logfile() {
    local service=$1
    echo "$BASE_DIR/logs/${service}.log"
}

# Check if service is running
is_running() {
    local service=$1
    local pidfile=$(get_pidfile "$service")

    if [[ ! -f "$pidfile" ]]; then
        return 1
    fi

    local pid=$(cat "$pidfile")
    if ps -p "$pid" > /dev/null 2>&1; then
        return 0
    else
        # PID file exists but process is dead
        rm -f "$pidfile"
        return 1
    fi
}

# Get process ID
get_pid() {
    local service=$1
    local pidfile=$(get_pidfile "$service")

    if [[ -f "$pidfile" ]]; then
        cat "$pidfile"
    else
        echo ""
    fi
}

# Load environment variables
load_env() {
    local service=$1
    local service_dir="$BASE_DIR/${SERVICES[$service]}"
    local env_file="$service_dir/.env"

    if [[ -f "$env_file" ]]; then
        log_info "Loading environment from $env_file"
        set -a
        source "$env_file"
        set +a
    else
        log_warning "No .env file found at $env_file"
    fi
}

# Get bundle command (rbenv-aware)
get_bundle_cmd() {
    # Try rbenv shims first
    if [[ -d "$HOME/.rbenv/shims" ]] && [[ -x "$HOME/.rbenv/shims/bundle" ]]; then
        echo "$HOME/.rbenv/shims/bundle"
    # Try system bundle
    elif command -v bundle >/dev/null 2>&1; then
        command -v bundle
    else
        echo "bundle"
    fi
}

# Check prerequisites before starting services
check_prerequisites() {
    local service=$1
    local service_dir="$BASE_DIR/${SERVICES[$service]}"
    local env_file="$service_dir/.env"
    local failed=0

    log_info "Checking prerequisites for $service..."

    # 1. Check if service directory exists
    if [[ ! -d "$service_dir" ]]; then
        log_error "Service directory not found: $service_dir"
        return 1
    fi

    # 2. Check .env file
    if [[ ! -f "$env_file" ]]; then
        log_error ".env file not found: $env_file"
        log_error "Please create .env file (copy from .env.example if available)"
        failed=1
    else
        # Load .env for further checks
        set -a
        source "$env_file" 2>/dev/null || true
        set +a
    fi

    # For backend services (Puma), check more prerequisites
    if [[ "${SERVICE_TYPES[$service]}" == "puma" ]]; then

        # 3. Check PostgreSQL
        local db_url="${WP_DEV_DATABASE_URL:-}"
        if [[ -n "$db_url" ]]; then
            # Parse database URL: postgres://[user[:password]@]host:port/database
            local db_user=$(echo "$db_url" | sed -n 's|.*://\([^:@]*\)[@:].*|\1|p')
            local db_pass=$(echo "$db_url" | sed -n 's|.*://[^:]*:\([^@]*\)@.*|\1|p')
            local db_host=$(echo "$db_url" | sed -n 's|.*@\([^:]*\):.*|\1|p')
            local db_port=$(echo "$db_url" | sed -n 's|.*:\([0-9]*\)/.*|\1|p')
            local db_name=$(echo "$db_url" | sed -n 's|.*/\([^?]*\).*|\1|p')

            # Defaults
            if [[ -z "$db_user" ]]; then db_user="postgres"; fi
            if [[ -z "$db_host" ]]; then db_host="localhost"; fi
            if [[ -z "$db_port" ]]; then db_port="5432"; fi

            if command -v pg_isready >/dev/null 2>&1; then
                if pg_isready -h "$db_host" -p "$db_port" -U "$db_user" >/dev/null 2>&1; then
                    log_success "PostgreSQL is running on $db_host:$db_port"

                    # Check if database exists (skip if psql requires password and we don't have it)
                    if command -v psql >/dev/null 2>&1; then
                        # Try to connect - set PGPASSWORD if we have it
                        local pg_env=""
                        if [[ -n "$db_pass" ]]; then
                            pg_env="PGPASSWORD='$db_pass'"
                        fi

                        # Try to list databases (suppress password prompts)
                        if eval "$pg_env psql -h '$db_host' -p '$db_port' -U '$db_user' -lqt 2>/dev/null" | cut -d \| -f 1 | grep -qw "$db_name"; then
                            log_success "Database '$db_name' exists"
                        else
                            # If psql fails, don't fail the check - just warn
                            log_warning "Could not verify database '$db_name' (authentication may be required)"
                            log_warning "The service will attempt to connect when starting"
                        fi
                    fi
                else
                    log_error "PostgreSQL is NOT running on $db_host:$db_port"
                    log_error "Start it with: brew services start postgresql@15  (macOS)"
                    log_error "               sudo systemctl start postgresql  (Linux)"
                    failed=1
                fi
            else
                log_warning "pg_isready not found, skipping PostgreSQL check"
            fi
        else
            log_warning "WP_DEV_DATABASE_URL not set, skipping database check"
        fi

        # 4. Check Memcached (CRITICAL for WebPay)
        local memcached_port=11211
        if command -v nc >/dev/null 2>&1; then
            if (echo "stats" | nc -w 1 localhost "$memcached_port" 2>/dev/null | grep -q "STAT"); then
                log_success "Memcached is running on port $memcached_port"
            elif lsof -i ":$memcached_port" >/dev/null 2>&1; then
                log_success "Memcached is running on port $memcached_port"
            else
                log_error "Memcached is NOT running on port $memcached_port"
                log_error ""
                log_error "CRITICAL: WebPay REQUIRES Memcached to function!"
                log_error ""
                log_error "Install and start Memcached:"
                log_error "  macOS:  brew install memcached && brew services start memcached"
                log_error "  Linux:  sudo apt-get install memcached && sudo systemctl start memcached"
                log_error "  Manual: memcached -d -m 64 -p 11211"
                log_error ""
                failed=1
            fi
        else
            # Fallback to lsof if nc not available
            if lsof -i ":$memcached_port" >/dev/null 2>&1; then
                log_success "Memcached is running on port $memcached_port"
            else
                log_error "Memcached is NOT running on port $memcached_port"
                failed=1
            fi
        fi

        # 5. Check if bundle dependencies are installed
        if command -v bundle >/dev/null 2>&1; then
            cd "$service_dir"
            if bundle check >/dev/null 2>&1; then
                log_success "Bundle dependencies are installed"
            else
                log_warning "Some bundle dependencies are missing or outdated"
                log_warning "Run: cd $service_dir && bundle install"
            fi
            cd "$BASE_DIR"
        fi
    fi

    # For frontend services (Webpack), check node_modules
    if [[ "${SERVICE_TYPES[$service]}" == "webpack" ]]; then
        if [[ -d "$service_dir/node_modules" ]]; then
            log_success "node_modules directory exists"
        else
            log_warning "node_modules not found"
            log_warning "Run: cd $service_dir && npm install"
        fi
    fi

    if [ $failed -eq 1 ]; then
        log_error "Prerequisites check FAILED for $service"
        log_error "Please fix the issues above before starting the service"
        return 1
    else
        log_success "All prerequisites OK for $service"
        return 0
    fi
}

# Start Puma service
start_puma() {
    local service=$1
    local service_dir="$BASE_DIR/${SERVICES[$service]}"
    local port=${SERVICE_PORTS[$service]}
    local pidfile=$(get_pidfile "$service")
    local logfile=$(get_logfile "$service")
    local bundle_cmd=$(get_bundle_cmd)
    local env_file="$service_dir/.env"

    log_info "Starting $service (Puma on port $port)..."
    log_info "Using bundle: $bundle_cmd"

    # Check if .env exists
    if [[ ! -f "$env_file" ]]; then
        log_warning "No .env file found at $env_file"
    else
        log_info "Loading environment from $env_file"
    fi

    # Create necessary directories
    mkdir -p "$BASE_DIR/tmp/pids"
    mkdir -p "$BASE_DIR/logs"
    mkdir -p "$service_dir/tmp/pids"  # Puma needs this in service dir
    mkdir -p "$service_dir/log"       # Puma may redirect stdout/stderr here

    # Start Puma in background with environment variables
    # Note: Puma 6.x removed --daemonize, use nohup with env
    cd "$service_dir"

    # Remove old PID file if it exists
    rm -f "$pidfile"

    # Create a wrapper script to load env and start puma
    local wrapper_script="/tmp/webpay-start-${service}-$$.sh"
    cat > "$wrapper_script" << WRAPPER_EOF
#!/usr/bin/env bash
cd "$service_dir"
if [[ -f "$env_file" ]]; then
    set -a
    source "$env_file"
    set +a
fi
# For development, use simple single-worker mode (ignore config/puma.rb)
exec "$bundle_cmd" exec puma -p "$port" --pidfile "$pidfile" -t 5:5 -w 0
WRAPPER_EOF

    chmod +x "$wrapper_script"

    # Start wrapper in background (OS-specific)
    if [[ "$OS_TYPE" == "macos" ]]; then
        # macOS: Load env vars and start puma
        # Parse .env file and export variables
        if [[ -f "$env_file" ]]; then
            set -a
            source "$env_file"
            set +a
        fi

        # Start puma in background and capture PID
        cd "$service_dir"
        nohup "$bundle_cmd" exec puma -p "$port" -t 5:5 -w 0 > "$logfile" 2>&1 &
        local puma_pid=$!
        echo "$puma_pid" > "$pidfile"

        # Return to base dir
        cd "$BASE_DIR"
    else
        # Linux: use setsid for proper daemonization
        nohup setsid "$wrapper_script" > "$logfile" 2>&1 &
        # Wait for Puma to write its PID file
        local count=0
        while [[ ! -f "$pidfile" ]] && [ $count -lt 20 ]; do
            sleep 0.5
            count=$((count + 1))
        done
    fi

    # Clean up wrapper script after a delay
    (sleep 5 && rm -f "$wrapper_script") &

    # Give it time to fully start
    sleep 2

    if is_running "$service"; then
        log_success "$service started successfully (PID: $(get_pid $service))"
    else
        log_error "$service failed to start"
        log_error "Check logs: tail -f $(get_logfile $service)"
        return 1
    fi
}

# Start Webpack service
start_webpack() {
    local service=$1
    local service_dir="$BASE_DIR/${SERVICES[$service]}"
    local port=${SERVICE_PORTS[$service]}
    local pidfile=$(get_pidfile "$service")
    local logfile=$(get_logfile "$service")
    local env_file="$service_dir/.env"

    log_info "Starting $service (Webpack dev server on port $port)..."

    # Check if .env exists
    if [[ ! -f "$env_file" ]]; then
        log_warning "No .env file found at $env_file"
    else
        log_info "Loading environment from $env_file"
    fi

    # Create necessary directories
    mkdir -p "$BASE_DIR/tmp/pids"
    mkdir -p "$BASE_DIR/logs"

    # Remove old PID file if it exists
    rm -f "$pidfile"

    # Load env vars if present
    if [[ -f "$env_file" ]]; then
        set -a
        source "$env_file"
        set +a
    fi

    # Start Webpack in background
    cd "$service_dir"
    nohup npm run dev > "$logfile" 2>&1 &
    local pid=$!
    echo "$pid" > "$pidfile"

    # Return to base dir
    cd "$BASE_DIR"

    sleep 3

    if is_running "$service"; then
        log_success "$service started successfully (PID: $(get_pid $service))"
    else
        log_error "$service failed to start"
        log_error "Check logs: tail -f $(get_logfile $service)"
        return 1
    fi
}

# Start service
start_service() {
    local service=$1

    if is_running "$service"; then
        log_warning "$service is already running (PID: $(get_pid $service))"
        return 0
    fi

    # Check prerequisites before starting
    if ! check_prerequisites "$service"; then
        log_error "Cannot start $service - prerequisites check failed"
        return 1
    fi

    local service_type=${SERVICE_TYPES[$service]}

    if [[ "$service_type" == "puma" ]]; then
        start_puma "$service"
    elif [[ "$service_type" == "webpack" ]]; then
        start_webpack "$service"
    else
        log_error "Unknown service type: $service_type"
        return 1
    fi
}

# Stop service
stop_service() {
    local service=$1

    if ! is_running "$service"; then
        log_warning "$service is not running"
        return 0
    fi

    local pid=$(get_pid "$service")
    local pidfile=$(get_pidfile "$service")

    log_info "Stopping $service (PID: $pid)..."

    # Send TERM signal
    kill -TERM "$pid" 2>/dev/null || true

    # Wait for process to stop (max 30 seconds)
    local count=0
    while ps -p "$pid" > /dev/null 2>&1 && [ $count -lt 30 ]; do
        sleep 1
        count=$((count + 1))
    done

    # Force kill if still running
    if ps -p "$pid" > /dev/null 2>&1; then
        log_warning "Process didn't stop gracefully, force killing..."
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi

    # Clean up PID file
    rm -f "$pidfile"

    if ! is_running "$service"; then
        log_success "$service stopped successfully"
    else
        log_error "$service failed to stop"
        return 1
    fi
}

# Graceful restart (Puma only - uses phased restart)
graceful_service() {
    local service=$1
    local service_type=${SERVICE_TYPES[$service]}

    if [[ "$service_type" != "puma" ]]; then
        log_warning "Graceful restart only supported for Puma services, doing regular restart..."
        restart_service "$service"
        return $?
    fi

    if ! is_running "$service"; then
        log_warning "$service is not running, starting instead..."
        start_service "$service"
        return $?
    fi

    local pid=$(get_pid "$service")

    log_info "Performing graceful restart of $service (PID: $pid)..."

    # Send USR2 signal for phased restart
    kill -USR2 "$pid" 2>/dev/null || {
        log_error "Failed to send USR2 signal, doing regular restart..."
        restart_service "$service"
        return $?
    }

    log_success "$service graceful restart initiated (workers will reload gradually)"
}

# Restart service
restart_service() {
    local service=$1

    log_info "Restarting $service..."

    if is_running "$service"; then
        stop_service "$service" || return 1
    fi

    start_service "$service"
}

# Show service status
status_service() {
    local service=$1
    local port=${SERVICE_PORTS[$service]}
    local service_type=${SERVICE_TYPES[$service]}

    if is_running "$service"; then
        local pid=$(get_pid "$service")
        local mem=$(ps -o rss= -p "$pid" | awk '{print int($1/1024)"M"}')
        local uptime=$(ps -o etime= -p "$pid" | xargs)
        echo -e "${GREEN}●${NC} $service (${service_type}:${port}) - ${GREEN}running${NC} (PID: $pid, Mem: $mem, Uptime: $uptime)"
    else
        echo -e "${RED}●${NC} $service (${service_type}:${port}) - ${RED}stopped${NC}"
    fi
}

# Tail logs
logs_service() {
    local service=$1
    local logfile=$(get_logfile "$service")

    if [[ ! -f "$logfile" ]]; then
        log_error "Log file not found: $logfile"
        return 1
    fi

    log_info "Tailing logs for $service (Ctrl+C to exit)..."
    tail -f "$logfile"
}

# Main command dispatcher
cmd_start() {
    local target=${1:-all}

    if [[ "$target" == "all" ]]; then
        log_info "Starting all services..."
        for service in master admin-master spa admin-spa; do
            start_service "$service"
        done
    elif [[ -n "${SERVICES[$target]}" ]]; then
        start_service "$target"
    else
        log_error "Unknown service: $target"
        echo "Available services: master, admin-master, spa, admin-spa, all"
        exit 1
    fi
}

cmd_stop() {
    local target=${1:-all}

    if [[ "$target" == "all" ]]; then
        log_info "Stopping all services..."
        for service in admin-spa spa admin-master master; do
            stop_service "$service"
        done
    elif [[ -n "${SERVICES[$target]}" ]]; then
        stop_service "$target"
    else
        log_error "Unknown service: $target"
        echo "Available services: master, admin-master, spa, admin-spa, all"
        exit 1
    fi
}

cmd_restart() {
    local target=${1:-all}

    if [[ "$target" == "all" ]]; then
        log_info "Restarting all services..."
        cmd_stop all
        sleep 2
        cmd_start all
    elif [[ -n "${SERVICES[$target]}" ]]; then
        restart_service "$target"
    else
        log_error "Unknown service: $target"
        echo "Available services: master, admin-master, spa, admin-spa, all"
        exit 1
    fi
}

cmd_graceful() {
    local target=${1:-all}

    if [[ "$target" == "all" ]]; then
        log_info "Graceful restart of all Puma services..."
        for service in master admin-master; do
            graceful_service "$service"
        done
    elif [[ -n "${SERVICES[$target]}" ]]; then
        graceful_service "$target"
    else
        log_error "Unknown service: $target"
        echo "Available services: master, admin-master, spa, admin-spa, all"
        exit 1
    fi
}

cmd_status() {
    local target=${1:-all}

    echo "WebPay Services Status:"
    echo "======================="

    if [[ "$target" == "all" ]]; then
        for service in master admin-master spa admin-spa; do
            status_service "$service"
        done
    elif [[ -n "${SERVICES[$target]}" ]]; then
        status_service "$target"
    else
        log_error "Unknown service: $target"
        echo "Available services: master, admin-master, spa, admin-spa, all"
        exit 1
    fi
}

cmd_logs() {
    local target=$1

    if [[ -z "$target" ]] || [[ "$target" == "all" ]]; then
        log_error "Please specify a service name for logs"
        echo "Available services: master, admin-master, spa, admin-spa"
        exit 1
    elif [[ -n "${SERVICES[$target]}" ]]; then
        logs_service "$target"
    else
        log_error "Unknown service: $target"
        echo "Available services: master, admin-master, spa, admin-spa"
        exit 1
    fi
}

# Show usage
usage() {
    cat << EOF
WebPay Control Script

Usage:
  webpay-ctl <command> [service]

Commands:
  start [service]         Start all services or specific service
  stop [service]          Stop all services or specific service
  restart [service]       Restart all services or specific service
  graceful [service]      Graceful restart (Puma only, zero-downtime)
  status [service]        Show status of all services or specific service
  logs <service>          Tail logs for service

Services:
  master                  webpay-master (Puma on port 4444)
  admin-master            webpay-admin-master (Puma on port 5555)
  spa                     webpay-spa (Webpack on port 2222)
  admin-spa               webpay-admin-spa (Webpack on port 3333)
  all                     All services (default)

Examples:
  webpay-ctl start                    # Start all services
  webpay-ctl start master             # Start only webpay-master
  webpay-ctl stop all                 # Stop all services
  webpay-ctl restart spa              # Restart webpay-spa
  webpay-ctl graceful master          # Graceful restart of webpay-master
  webpay-ctl status                   # Show status of all services
  webpay-ctl logs master              # Tail logs for webpay-master

EOF
}

# Main entry point
main() {
    local command=$1
    shift || true

    case "$command" in
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        graceful)
            cmd_graceful "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            log_error "Unknown command: $command"
            usage
            exit 1
            ;;
    esac
}

main "$@"
